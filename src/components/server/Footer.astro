---
import { FaFacebook, FaInstagram, FaWhatsapp } from "react-icons/fa";
import { getTranslations } from "../../utils/translations";
import { getLocalizedPath } from "../../utils/languages";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const homePath = getLocalizedPath(lang);
const corcovadoPath = getLocalizedPath(lang, "corcovado");

const navItems = [
  { label: t.nav.home, href: homePath },
  { label: t.nav.about, href: `${homePath}#about` },
  { label: t.nav.corcovado, href: corcovadoPath },
  { label: t.nav.contact, href: getLocalizedPath(lang, "contact") },
];

const year = new Date().getFullYear();
---

<footer class="bg-accent-900 text-white">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-5">
      <div class="sm:col-span-2 lg:col-span-2">
        <a href={homePath} class="flex items-center gap-2">
          <img src="/logo-adi.png" alt="ADI Corcovado" class="h-24 w-auto" />
        </a>
        <p class="mt-4 max-w-sm text-md text-accent-200">{t.footer.tagline}</p>
      </div>

      <div>
        <h3
          class="text-sm font-semibold tracking-wide text-accent-200 uppercase"
        >
          {t.footer.linksTitle}
        </h3>
        <ul class="mt-4 space-y-3">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-md text-white/80 transition-colors hover:text-white"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h3
          class="text-sm font-semibold tracking-wide text-accent-200 uppercase"
        >
          {t.footer.contactTitle}
        </h3>
        <ul class="mt-4 space-y-3 text-md text-white/80">
          <li>{t.footer.address}</li>
          <li>
            <a href={`mailto:${t.footer.email}`} class="hover:text-white">
              {t.footer.email}
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/50685978686"
              class="hover:text-white"
              target="_blank"
              rel="noopener noreferrer"
            >
              {t.footer.phone}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3
          class="text-sm font-semibold tracking-wide text-accent-200 uppercase"
        >
          {t.footer.socialTitle}
        </h3>
        <div class="mt-4 flex items-center gap-4">
          <a
            href="https://www.facebook.com/adicorcovadocarate"
            aria-label={t.footer.facebookLabel}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/80 transition-colors hover:text-white"
          >
            <FaFacebook className="h-6 w-6" />
          </a>
          <a
            href="https://www.instagram.com/corcovadocarate/"
            aria-label={t.footer.instagramLabel}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/80 transition-colors hover:text-white"
          >
            <FaInstagram className="h-6 w-6" />
          </a>
          <a
            href="https://wa.me/50685978686"
            aria-label={t.footer.whatsappLabel}
            target="_blank"
            rel="noopener noreferrer"
            class="text-white/80 transition-colors hover:text-white"
          >
            <FaWhatsapp className="h-6 w-6" />
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-8 text-sm text-accent-200">
      &copy; {year} ADI Corcovado Carate. {t.footer.rights}
    </div>
  </div>
</footer>
