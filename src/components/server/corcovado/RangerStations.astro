---
import Section from "../Section.astro";
import Button from "../Button.astro";
import Reveal from "../../client/Reveal";
import { getTranslations } from "../../../utils/translations";
import { getLocalizedPath } from "../../../utils/languages";
import { STATION_SLUGS } from "../../../utils/stations";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const translations = getTranslations(lang);
const t = translations.corcovadoPage.stations;
const stations = translations.stations;
---

<Section id="stations" background="muted">
  <Reveal client:visible className="max-w-2xl">
    <p
      class="font-brevia text-sm font-semibold tracking-wide text-primary-600 uppercase"
    >
      {t.eyebrow}
    </p>
    <h2 class="mt-4 text-3xl font-bold text-accent-900 sm:text-4xl">
      {t.title}
    </h2>
    <p class="mt-6 text-xl text-accent-700">
      {t.subtitle}
    </p>
  </Reveal>

  <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {
      STATION_SLUGS.map((slug, index) => {
        const station = stations[slug];
        return (
          <Reveal client:visible delay={index * 0.1}>
            <article class="flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-sm">
              <img
                src={station.heroImage}
                alt={station.heroImageAlt}
                class="aspect-4/3 w-full rounded-2xl object-cover"
              />
              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-xl font-bold text-accent-900">
                  {station.title}
                </h3>
                <p class="mt-3 flex-1 text-accent-700 text-lg">
                  {station.subtitle}
                </p>
                <Button
                  href={getLocalizedPath(lang, `corcovado/${slug}`)}
                  variant="primary"
                  size="md"
                  class="mt-6 self-start"
                >
                  {t.cta}
                </Button>
              </div>
            </article>
          </Reveal>
        );
      })
    }
  </div>
</Section>
