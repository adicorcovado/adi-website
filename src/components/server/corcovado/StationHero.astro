---
import Reveal from "../../client/Reveal";
import { getTranslations } from "../../../utils/translations";
import type { StationSlug } from "../../../utils/stations";

interface Props {
  lang: string;
  slug: StationSlug;
}

const { lang, slug } = Astro.props;
const t = getTranslations(lang).stations[slug];
---

<section class="relative overflow-hidden bg-accent-900">
  <img
    src={t.heroImage}
    alt={t.heroImageAlt}
    class="absolute inset-0 h-full w-full object-cover opacity-50"
  />
  <div
    class="absolute inset-0 bg-linear-to-t from-accent-900 via-accent-900/80 to-accent-900/40"
  >
  </div>
  <div class="relative mx-auto max-w-7xl px-6 py-24 sm:py-32 lg:px-8">
    <Reveal client:load mode="mount" className="max-w-2xl">
      <p
        class="font-brevia text-sm font-semibold tracking-wide text-primary-200 uppercase"
      >
        {t.eyebrow}
      </p>
      <h1 class="mt-4 text-4xl font-bold text-white sm:text-5xl lg:text-6xl">
        {t.title}
      </h1>
      <p class="mt-6 text-xl text-white/90">
        {t.subtitle}
      </p>
    </Reveal>
  </div>
</section>
