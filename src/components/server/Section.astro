---
interface Props {
  id?: string;
  background?: "white" | "muted" | "primary" | "accent";
  class?: string;
  containerClass?: string;
}

const {
  id,
  background = "white",
  class: className = "",
  containerClass = "",
} = Astro.props;

const backgrounds: Record<NonNullable<Props["background"]>, string> = {
  white: "bg-white text-accent-900",
  muted: "bg-primary-50 text-accent-900",
  primary: "bg-primary-500 text-white",
  accent: "bg-accent-500 text-white",
};
---

<section
  id={id}
  class={`${id ? "scroll-mt-28" : ""} ${backgrounds[background]} ${className}`}
>
  <div class={`mx-auto max-w-7xl px-6 py-16 sm:py-20 lg:px-8 lg:py-28 ${containerClass}`}>
    <slot />
  </div>
</section>
