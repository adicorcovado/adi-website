---
import Button from "../Button.astro";
import Reveal from "../../client/Reveal";
import { getTranslations } from "../../../utils/translations";
import { getLocalizedPath } from "../../../utils/languages";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getTranslations(lang).home.hero;
const homePath = getLocalizedPath(lang);
---

<section class="overflow-hidden bg-primary-50">
  <div
    class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-16 sm:py-20 lg:grid-cols-2 lg:px-8 lg:py-28"
  >
    <Reveal client:load mode="mount">
      <p
        class="font-brevia text-sm font-semibold tracking-wide text-primary-600 uppercase"
      >
        {t.eyebrow}
      </p>
      <h1
        class="mt-4 text-4xl font-bold text-accent-900 sm:text-5xl lg:text-6xl"
      >
        {t.title}
      </h1>
      <p class="mt-6 max-w-xl text-xl text-accent-700">
        {t.subtitle}
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button href={`${homePath}#our-work`} size="lg">{t.primaryCta}</Button>
        <!-- <Button href={`${homePath}#projects`} variant="outline" size="lg">
          {t.secondaryCta}
        </Button> -->
      </div>
    </Reveal>

    <Reveal client:load mode="mount" delay={0.15}>
      <img
        src="/images/home/home-2.webp"
        alt={t.imageAlt}
        class="aspect-4/3 w-full rounded-2xl object-cover"
      />
    </Reveal>
  </div>
</section>
