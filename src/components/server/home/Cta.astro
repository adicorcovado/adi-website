---
import Section from "../Section.astro";
import Button from "../Button.astro";
import Reveal from "../../client/Reveal";
import { getTranslations } from "../../../utils/translations";
import { getLocalizedPath } from "../../../utils/languages";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const translations = getTranslations(lang);
const t = translations.home.cta;
const email = translations.footer.email;
---

<Section id="contact" background="primary" containerClass="text-center">
  <Reveal client:visible className="mx-auto max-w-2xl">
    <h2 class="text-3xl font-bold sm:text-4xl">{t.title}</h2>
    <p class="mt-4 text-xl text-primary-50">{t.subtitle}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <!-- <Button
        href={getLocalizedPath(lang, "contact")}
        variant="secondary"
        size="lg"
      >
        {t.primaryCta}
      </Button> -->
      <Button
        href={getLocalizedPath(lang, "contact")}
        variant="inverse"
        size="lg"
      >
        {t.secondaryCta}
      </Button>
    </div>
  </Reveal>
</Section>
