---
import Section from "../Section.astro";
import PlaceholderImage from "../PlaceholderImage.astro";
import Reveal from "../../client/Reveal";
import { getTranslations } from "../../../utils/translations";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getTranslations(lang).home.intro;
---

<Section id="about" background="white">
  <div class="grid items-center gap-12 lg:grid-cols-2">
    <Reveal client:visible>
      <PlaceholderImage
        label={t.imageAlt}
        variant="secondary"
        aspect="aspect-[4/3]"
        class="w-full"
      />
    </Reveal>

    <Reveal client:visible delay={0.1}>
      <p class="font-brevia text-sm font-semibold tracking-wide text-primary-600 uppercase">
        {t.eyebrow}
      </p>
      <h2 class="mt-4 text-3xl font-bold text-accent-900 sm:text-4xl">
        {t.title}
      </h2>
      <p class="mt-6 text-lg text-accent-700">
        {t.body}
      </p>
    </Reveal>
  </div>
</Section>
