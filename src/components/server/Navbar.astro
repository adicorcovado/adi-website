---
import Button from "./Button.astro";
import MobileMenu from "../client/MobileMenu";
import { getTranslations } from "../../utils/translations";
import {
  getLocalizedPath,
  stripLangPrefix,
  supportedLanguages,
} from "../../utils/languages";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const homePath = getLocalizedPath(lang);
const currentSlug = stripLangPrefix(Astro.url.pathname, lang);

const navItems = [
  { label: t.nav.home, href: homePath },
  { label: t.nav.about, href: `${homePath}#about` },
  { label: t.nav.corcovado, href: getLocalizedPath(lang, "corcovado") },
  { label: t.nav.contact, href: getLocalizedPath(lang, "contact") },
];

const cta = { label: t.nav.bookNow, href: getLocalizedPath(lang, "booking") };

const languageLabels: Record<string, string> = { en: "EN", es: "ES" };
const languages = supportedLanguages.map((code) => ({
  code,
  label: languageLabels[code] ?? code.toUpperCase(),
  href: getLocalizedPath(code, currentSlug),
  current: code === lang,
}));
---

<header class="sticky top-0 z-30 bg-white/90 backdrop-blur-sm">
  <div
    class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-8"
  >
    <a href={homePath} class="flex items-center gap-2">
      <img src="/logo-adi.png" alt="ADI Corcovado" class="h-20 w-auto" />
    </a>

    <nav class="hidden items-center gap-8 lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="text-xl font-semibold text-accent-900 transition-colors hover:text-primary-500"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-6 lg:flex">
      <div class="flex items-center gap-2 text-md font-semibold">
        {
          languages.map((option, index) => (
            <>
              {index > 0 && <span class="text-accent-200">/</span>}
              <a
                href={option.href}
                class={
                  option.current
                    ? "text-primary-600"
                    : "text-accent-400 hover:text-primary-500"
                }
              >
                {option.label}
              </a>
            </>
          ))
        }
      </div>
      <Button href={cta.href} size="md">{cta.label}</Button>
    </div>

    <MobileMenu
      client:load
      navItems={navItems}
      cta={cta}
      languages={languages}
    />
  </div>
</header>
